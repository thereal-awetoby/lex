# HSK Chain
# MCP network (177 mainnet, 133 testnet)
HSK_CHAIN_ID=177
HSK_RPC_URL=https://mainnet.hsk.xyz

# Deploy
DEPLOYER_PRIVATE_KEY=0x...

# Agent
AGENT_PRIVATE_KEY=0x...

# Contracts (fill after deploy)
LEX_MANDATE_ADDRESS=0x...

# Token (USDC.e default)
TOKEN_ADDRESS=0x054ed45810DbBAb8B27668922D110669c9D88D0a

# App (Next.js)
NEXT_PUBLIC_MANDATE_ADDRESS=0x...
NEXT_PUBLIC_HSK_RPC_URL=
NEXT_PUBLIC_DEPLOY_BLOCK=0

# HSP (merchant side, optional)
HSP_BASE_URL=https://merchant-qa.hashkeymerchant.com
HSP_APP_KEY=
HSP_APP_SECRET=
HSP_MERCHANT_NAME=
HSP_MERCHANT_PRIVATE_KEY=
HSP_NETWORK=hashkey-testnet

# Optional proof-run relayer (defaults to owner); also enables the app relayer.
# Server-side only: use a dedicated key with a small gas balance.
RELAYER_PRIVATE_KEY=
# Leave empty to use the selected network's explorer.
NEXT_PUBLIC_EXPLORER_URL=

# App network: 177 mainnet (default), 133 testnet
NEXT_PUBLIC_CHAIN_ID=177
# Optional comma-separated mandate IDs served by the relayer; empty means all mandates.
RELAY_MANDATE_IDS=
# MCP server: configured app relayer endpoint, e.g. https://<app>/api/relay
LEX_RELAYER_URL=
